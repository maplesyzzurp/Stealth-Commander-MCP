{
  "name": "stealth-commander-oauth-candidate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:site && npm run build:worker",
    "build:site": "node web/build.mjs",
    "build:worker": "esbuild src/index.js --bundle --format=esm --platform=browser --external:cloudflare:workers --outfile=build/worker.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
