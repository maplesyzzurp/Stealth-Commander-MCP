// Example only. Add an account-unique positive integer namespace_id to LIMITS before deployment.
{
  "name": "stealthcommander-auth-rate-limit",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "ratelimits": [
    {
      "name": "LIMITS",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
